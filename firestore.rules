rules_version = '2';

// Reglas de Firestore de Txispa Type. Cada persona solo accede a lo suyo, los intentos se crean una vez y no se
// modifican, y se valida la forma de lo que se escribe. Todo lo demás está cerrado.
// Se publican con `firebase deploy --only firestore:rules` o pegándolas en consola > Firestore > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if esDueno(uid);
      // Solo el contador de "Borrar todo" y la versión del modelo.
      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['schema', 'resetEpoch'])
        && request.resource.data.schema is int
        && request.resource.data.resetEpoch is int
        && request.resource.data.resetEpoch >= 0;
      allow delete: if false;

      match /intentos/{id} {
        allow read: if esDueno(uid);

        // Se crea una vez; sin `update`: un intento es un hecho inmutable.
        allow create: if esDueno(uid)
          && id.matches('^[A-Za-z0-9-]{1,64}$')
          && request.resource.data.id == id
          && request.resource.data.modo in ['test', 'entreno']
          && request.resource.data.wpm is number && request.resource.data.wpm >= 0 && request.resource.data.wpm < 500
          && request.resource.data.acc is number && request.resource.data.acc >= 0 && request.resource.data.acc <= 100
          && request.resource.data.durationSec is number
          && request.resource.data.localDate is string
          && request.resource.data.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.teclas is map
          && request.resource.data.pares is map
          && request.resource.data.confusiones is map
          && request.resource.data.keys().size() < 40
          && (!('leccionId' in request.resource.data)
              || (request.resource.data.leccionId is string
                  && request.resource.data.leccionId.matches('^[a-z]{2,12}/L[0-9]{2}\\.([0-9]{2}|R|J)$')))
          && request.resource.data.syncedAt == request.time;
        allow update: if false;
        // Necesario para "Borrar también en la nube".
        allow delete: if esDueno(uid);
      }

      // Subconjunto sincronizable de Ajustes (lib/ajustes.ts, CLAVES_SINCRONIZABLES). Un solo documento, "actual",
      // que se escribe entero; `updatedAt` es la hora del servidor y decide la última escritura.
      match /ajustes/{doc} {
        allow read: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && doc == 'actual'
          && request.resource.data.keys().hasOnly(['objetivoTests', 'objetivoMinutos', 'estrictoPorDefecto',
               'puntuacionYMayusculas', 'duracionPorDefecto', 'calentamientoMin', 'reglasDeAjuste', 'updatedAt'])
          && request.resource.data.keys().hasAll(['objetivoTests', 'objetivoMinutos', 'estrictoPorDefecto',
               'puntuacionYMayusculas', 'duracionPorDefecto', 'calentamientoMin', 'reglasDeAjuste', 'updatedAt'])
          && request.resource.data.objetivoTests is int
          && request.resource.data.objetivoTests >= 1 && request.resource.data.objetivoTests <= 20
          && request.resource.data.objetivoMinutos is int
          && request.resource.data.objetivoMinutos >= 1 && request.resource.data.objetivoMinutos <= 240
          && request.resource.data.estrictoPorDefecto is bool
          && request.resource.data.puntuacionYMayusculas is bool
          && request.resource.data.duracionPorDefecto in [30, 60, 120, 180, 300]
          && request.resource.data.calentamientoMin is int
          && request.resource.data.calentamientoMin >= 1 && request.resource.data.calentamientoMin <= 30
          && request.resource.data.reglasDeAjuste is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Tiempo extra del día (sesiones sin terminar). Solo se suma (`increment`): nunca baja y cada escritura
      // añade como mucho un día entero de segundos.
      match /dias/{dia} {
        allow read: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['extraSeg'])
          && request.resource.data.extraSeg is int
          && request.resource.data.extraSeg >= 0 && request.resource.data.extraSeg <= 1000000
          && request.resource.data.extraSeg - (resource == null ? 0 : resource.data.extraSeg) >= 0
          && request.resource.data.extraSeg - (resource == null ? 0 : resource.data.extraSeg) <= 86400;
        allow delete: if false;
      }

      // Pulsaciones de calentamientos. Solo se suma (`increment`); el límite por escritura cubre la migración inicial.
      match /contadores/{doc} {
        allow read: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && doc == 'global'
          && request.resource.data.keys().hasOnly(['calentamientoPuls'])
          && request.resource.data.calentamientoPuls is int
          && request.resource.data.calentamientoPuls >= 0
          && request.resource.data.calentamientoPuls - (resource == null ? 0 : resource.data.calentamientoPuls) >= 0
          && request.resource.data.calentamientoPuls - (resource == null ? 0 : resource.data.calentamientoPuls) <= 50000000;
        allow delete: if false;
      }
    }

    // ======================================================================================================
    // RANKING PÚBLICO (docs/RANKING.md). REGLAS NO PROBADAS: sin emulador de Firebase no se han ejecutado.
    // Perfil público en publico/{uid} y reserva de alias en alias/{aliasLower} = { uid }; el cliente
    // escribe ambos en un único writeBatch, por eso se valida con getAfter (estado tras el lote).
    // Límite conocido: el ppm lo envía el cliente y estas reglas solo validan forma y rangos, no que el
    // test haya ocurrido (ranking de confianza, la interfaz lo avisa).
    // ======================================================================================================
    match /publico/{uid} {
      allow read: if true;
      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['alias', 'mejorWpm', 'accMejor', 'tests', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['alias', 'mejorWpm', 'accMejor', 'tests', 'actualizadoEn'])
        && request.resource.data.alias is string
        && request.resource.data.alias.matches('^[A-Za-z0-9_-]{3,20}$')
        && request.resource.data.mejorWpm is number
        && request.resource.data.mejorWpm >= 0 && request.resource.data.mejorWpm <= 300
        && request.resource.data.accMejor is number
        && request.resource.data.accMejor >= 95 && request.resource.data.accMejor <= 100
        && request.resource.data.tests is int && request.resource.data.tests >= 1
        && request.resource.data.actualizadoEn == request.time
        // La reserva del alias (nueva o ya existente) tiene que ser nuestra tras el lote.
        && getAfter(/databases/$(database)/documents/alias/$(request.resource.data.alias.lower())).data.uid == uid;
      allow delete: if esDueno(uid);
    }

    match /alias/{aliasLower} {
      // Solo lectura de un alias concreto (comprobar si está libre); sin listar la colección.
      allow get: if true;
      allow list: if false;
      // Crear solo si el perfil público del lote usa ese alias; así nadie acapara alias sin publicar.
      allow create: if esDueno(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid'])
        && aliasLower.matches('^[a-z0-9_-]{3,20}$')
        && getAfter(/databases/$(database)/documents/publico/$(request.auth.uid)).data.alias.lower() == aliasLower;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
