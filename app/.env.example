# Configuración web de Firebase (consola de Firebase > Configuración del proyecto > Tus apps).
# No es secreta: viaja al navegador. La seguridad la dan las reglas de Firestore y el inicio de sesión.
# Copia este archivo a .env.local y rellénalo. Sin estas variables la app funciona solo en local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Poner a false para apagar la nube sin tocar código.
VITE_SYNC_ENABLED=true
